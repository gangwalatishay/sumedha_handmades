PORT=5050
CLIENT_ORIGIN=http://localhost:3000

# Create a database user and restrict network access in MongoDB Atlas.
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/DATABASE?retryWrites=true&w=majority

# Generate a unique random value of at least 32 characters.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

EMAIL_USER=
EMAIL_PASS=
ADMIN_EMAIL=
ADMIN_EMAIL_PASS=
